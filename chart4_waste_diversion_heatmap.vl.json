        "Wellington Shire",
        "Loddon Shire",
        "Hindmarsh Shire",
        "Yarriambiack Shire",
        "West Wimmera Shire"
      ],
      "title": null,
      "axis": {
        "labelFontSize": 12,
        "labelLimit": 235,
        "labelPadding": 5
      }
    },
    "color": {
      "field": "diversion_pct",
      "type": "quantitative",
      "title": "Diverted from landfill (%)",
      "scale": {
        "domain": [
          0,
          100
        ],
        "range": [
          "#eef6f8",
          "#b5dce0",
          "#5db0ba",
          "#12627f",
          "#073b5a"
        ],
        "unknown": "#e6e9eb"
      },
      "legend": {
        "orient": "bottom",
        "gradientLength": 300,
        "title": "Waste diverted from landfill (%)",
        "titleFontSize": 12,
        "labelFontSize": 11
      },
      "condition": {
        "test": "datum.diversion_pct == null || !isValid(datum.diversion_pct)",
        "value": "#e6e9eb"
      }
    },
    "tooltip": [
      {
        "field": "council",
        "title": "Council"
      },
      {
        "field": "group",
        "title": "Council group"
      },
      {
        "field": "year",
        "title": "Financial year"
      },
      {
        "field": "diversion_pct",
        "type": "quantitative",
        "title": "Waste diverted (%)",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#25485b",
      "titleColor": "#25485b"
    }
  },
  "description": "Waste diversion for 79 Victorian councils across five financial years; blank-labelled cells indicate unavailable observations.",
  "transform": [
    {
      "impute": "diversion_pct",
      "key": "year",
      "groupby": [
        "council"
      ],
      "keyvals": [
        "2020–21",
        "2021–22",
        "2022–23",
        "2023–24",
        "2024–25"
      ]
    }
  ]
}

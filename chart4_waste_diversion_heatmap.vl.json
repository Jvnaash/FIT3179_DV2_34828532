{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Waste diversion across Victorian councils, 2020–21 to 2024–25",
    "anchor": "start",
    "fontSize": 16,
    "color": "#102f43"
  },
  "width": 830,
  "height": {
    "step": 18
  },
  "background": "white",
  "data": {
    "url": "waste_diversion_2020_2025.csv"
  },
  "mark": {
    "type": "rect",
    "stroke": "#ffffff",
    "strokeWidth": 0.5
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "sort": [
        "2020–21",
        "2021–22",
        "2022–23",
        "2023–24",
        "2024–25"
      ],
      "title": "Financial year",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12,
        "titlePadding": 12,
        "labelPadding": 6
      }
    },
    "y": {
      "field": "council",
      "type": "nominal",
      "sort": [
        "Alpine Shire",
        "Manningham City",
        "Borough of Queenscliffe",
        "Knox City",
        "Monash City",
        "Macedon Ranges Shire",
